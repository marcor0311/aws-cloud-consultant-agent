LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
GOOGLE_OAUTH_CLIENT_FILE=secrets/google_oauth_client.json
GOOGLE_OAUTH_TOKEN_FILE=secrets/google_calendar_token.json
GOOGLE_CALENDAR_ID=primary

# Internal backend; the whitelist and SMTP credentials belong only to that backend.
CALENDAR_ACCESS_URL=http://127.0.0.1:8000/api/calendar-access
CALENDAR_ACCESS_SERVICE_KEY=
# Stable trusted origin for abuse limits. Default shares a limit across the service.
CALENDAR_ACCESS_ORIGIN_ID=calendar-assistant
