AZURE_OPENAI_ENDPOINT="https://your-resource-name.cognitiveservices.azure.com/"
AZURE_OPENAI_API_KEY="YOUR_AZURE_OPENAI_API_KEY"
AZURE_OPENAI_DEPLOYMENT="gpt-5.4-mini"
AZURE_OPENAI_API_VERSION="2024-12-01-preview"

# Internal calendar access API. Generate two different secrets (32+ characters).
CALENDAR_ACCESS_SERVICE_KEY=
CALENDAR_ACCESS_CODE_SECRET=
# Relative to project/, or an absolute path on persistent storage.
CALENDAR_ACCESS_DB=data/calendar-access.sqlite3

# Read-only lookup API owned by the external registration system.
# POST {"email":"..."}; returns {"registered":true,"enabled":true,"name":"..."}
CALENDAR_WHITELIST_URL=
CALENDAR_WHITELIST_API_KEY=

# Transactional verification emails. Use starttls (587) or ssl (465).
CALENDAR_MAIL_PROVIDER=smtp
# For gmail, keep the real address and OAuth files in private configuration.
GOOGLE_ACCOUNT_EMAIL=
CALENDAR_GMAIL_CLIENT_FILE=calendar_assistant/secrets/google_oauth_client.json
CALENDAR_GMAIL_TOKEN_FILE=secrets/gmail_token.json

# SMTP is optional when CALENDAR_MAIL_PROVIDER=gmail.
CALENDAR_SMTP_HOST=
CALENDAR_SMTP_PORT=587
CALENDAR_SMTP_SECURITY=starttls
CALENDAR_SMTP_USERNAME=
CALENDAR_SMTP_PASSWORD=
CALENDAR_SMTP_FROM=
# Optional generic display name. The template and subject have no company branding.
CALENDAR_SMTP_SENDER_NAME=
