# Non-sensitive local configuration. Credentials live outside the repository.
# Copy config/local-secrets.example/secrets.env.example to the private directory.
# Absolute path (a leading ~ is supported); relative secret file paths use this root.
CLOUD_CONSULTANT_SECRETS_DIR=~/.config/aws-cloud-consultant-agent/dev

CALENDAR_ACCESS_DB=data/calendar-access.sqlite3
CALENDAR_MAIL_PROVIDER=smtp
CALENDAR_GMAIL_CLIENT_FILE=google/oauth-client.json
CALENDAR_GMAIL_TOKEN_FILE=google/gmail-token.json
CALENDAR_SMTP_HOST=
CALENDAR_SMTP_PORT=587
CALENDAR_SMTP_SECURITY=starttls
CALENDAR_SMTP_SENDER_NAME=
LIVEKIT_INFERENCE_ENABLED=0
GOOGLE_OAUTH_CLIENT_FILE=google/oauth-client.json
GOOGLE_OAUTH_TOKEN_FILE=google/calendar-token.json
GOOGLE_CALENDAR_ID=primary
CALENDAR_ACCESS_URL=http://127.0.0.1:8000/api/calendar-access
CALENDAR_ACCESS_ORIGIN_ID=calendar-assistant
WORKFLOW_MODE=mock
WORKFLOW_MOCK_DIR=
WORKFLOW_ENABLED=0
WORKFLOW_INFERENCE_ENABLED=0
WORKFLOW_MANAGER_ID=engagement-manager
WORKFLOW_OPENAI_MODEL=
SLACK_EM_USER_ID=
WORKFLOW_GOOGLE_CLIENT_FILE=google/oauth-client.json
WORKFLOW_GOOGLE_TOKEN_FILE=google/workflow-token.json
WORKFLOW_CALENDAR_WEBHOOK_URL=
WORKFLOW_PUBSUB_TOPIC=
WORKFLOW_PUBSUB_SUBSCRIPTION=
WORKFLOW_PUSH_AUDIENCE=
WORKFLOW_PUSH_SERVICE_ACCOUNT=
WORKFLOW_GITHUB_REPOSITORIES=
